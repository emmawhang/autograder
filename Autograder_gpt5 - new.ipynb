    "from tqdm.notebook import tqdm\n",
    "\n",
    "for folder, name in tqdm(zip(folders, names), total=len(folders)):\n",
    "\n",
    "    if df.loc[name, \"Success\"] in [1, 2]:\n",
    "        continue\n",
    "\n",
    "    # Get the name of the submission\n",
    "    directory_path = submissions_path + folder\n",
    "\n",
    "    # Get a list of all files in the submission path\n",
    "    files = [file for file in os.listdir(directory_path) if os.path.isfile(os.path.join(directory_path, file))]\n",
    "\n",
    "    # Extract the code from the submission\n",
    "    try:\n",
    "        code, _ = get_code(os.path.join(directory_path, files[0]))\n",
    "    except:\n",
    "        print(f\"Error in reading the submission for {name}.\")\n",
    "        df.loc[name, \"Success\"] = 2\n",
    "        continue\n",
    "    \n",
    "    # Attempt grading up to 3 times\n",
    "    for attempt in [1, 2, 3]:\n",
    "        try:\n",
    "            # Read the submission and grade it\n",
    "            feedback = grade_submission(code, statement, solution, rubric, instructions, problems)\n",
    "\n",
    "            # Save the feedback to a file\n",
    "            feedback_file_name = feedback_path + f\"/{folder}/{folder}.txt\"\n",
    "            os.makedirs(os.path.dirname(feedback_file_name), exist_ok=True)\n",
    "            with open(feedback_file_name, 'w') as f:\n",
    "                f.write(feedback)\n",
    "        except Exception as e:\n",
    "            print(f\"Error in grading the submission for {name}: {e}\")\n",
    "            continue\n",
    "        \n",
    "        try:\n",
    "            # Extract the deductions from the feedback\n",
    "            deductions = extract_deductions(code, statement, solution, rubric, instructions, problems, feedback)\n",
    "        except:\n",
    "            print(f\"Error in extracting duductions for {name}.\")\n",
    "\n",
    "        try: \n",
    "            # Compile the deductions\n",
    "            compiled_deductions = compile_deductions(deductions)\n",
    "            df.loc[name, df.columns[:-1]] = compiled_deductions\n",
    "            df.loc[name, \"Success\"] = 1\n",
    "        except:\n",
    "            print(f\"Error in compiling deductions for {name}.\")\n",
    "            print(deductions)\n",
    "\n"
   ]
