   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [],
   "source": [
    "folders = [f.name for f in os.scandir(submissions_path) if f.is_dir()]\n",
    "names = [f.split(\"_\")[0] for f in folders]\n",
    "df = pd.DataFrame(index=names, columns = [f\"Problem {i}\" for i in range(1, problems+1)] + [\"Success\"], dtype=np.float64)\n",
    "# df = pd.DataFrame(index=names, columns = [f\"Criterion {i}\" for i in range(1, 16)] + [\"Success\"])\n",
    "df[\"Success\"] = 0"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {},
   "outputs": [],
   "source": [
    "instructions = \"\"\"You are a thorough teaching assistant for a class on financial analytics with Python. You are tasked with grading a few homework assignments. \\\n",
    "  Grade the assignments based on the provided rubric and solution. Provide detailed feedback on what was done well and what needs improvement. Use the rubric to determine point deductions for each criterion. \\\n",
    "    Ensure that your feedback is constructive and helps the student understand their mistakes and how to improve. Be specific in your comments and avoid generic statements. \\\n",
    "      Your goal is to help students learn and improve their skills in financial analytics with Python.\\n\\n\"\"\"\n",
    "\n",
    "from openai import OpenAI\n",
    "client = OpenAI(api_key=REDACTED"REDACTED\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {},
   "outputs": [],
   "source": [
    "def grade_submission(code, statement, solution, rubric, instructions, problems):\n",
    "    # Initial grading request\n",
    "    response = client.chat.completions.create(\n",
    "        model=\"gpt-5-mini\",\n",
    "        messages=[{\n",
    "            \"role\": \"system\",\n",
    "            \"content\": instructions\n",
    "        }, {\n",
    "            \"role\": \"user\", \n",
    "            \"content\": f\"\"\"The statement of the homework is as follows:\n",
    "\n",
    "        {statement}\n",
    "\n",
    "        A student has submitted the following Python code for this homework.\n",
    "\n",
    "        {code}\n",
    "\n",
    "        You also have access to the solution of this homework, which is as follows:\n",
    "\n",
    "        {solution}\n",
    "\n",
    "        In both the solution and the student's submission, each problem is separated with a comment line mentioning the problem number.\n",
    "\n",
    "        Use the following rubric:\n",
    "\n",
    "        {rubric}\n",
    "\n",
    "        Please grade the student's submission.\"\"\"\n",
    "        }],\n",
    "        # temperature=0\n",
    "    )\n",
    "\n",
    "    feedback = response.choices[0].message.content\n",
    "\n",
    "    return feedback\n",
    "\n",
    "def extract_deductions(code, statement, solution, rubric, instructions, problems, feedback):\n",
    "\n",
    "    if problems == 1:\n",
    "        content = \"Excellent. Now please add all the deducted points and provide the total deduction in the following format:\\n\\nTotal Deductions -- POINTS DEDUCTED\\n Please double-check that (a) your total deduction matches the sum of the individual deductions in the previous feedback; and (b) that the deductions are formatted correctly so that I can easily parse them. If you find a mistake, please extract the deductions again and double-check your work.\"\n",
    "    else:\n",
    "        content = \"Excellent. Now please summarize the deducted points in the following format:\\n\\n\" + \"\".join([f\"Problem {i} -- POINTS DEDUCTED \\n\" for i in range(1, problems+1)])\n",
    "        content = content + \"Please double-check that (a) the deductions you extracted in this step match those in the previous feedback; and (b) that the deductions are formatted correctly so that I can easily parse them. If you find a mistake, please extract the deductions again and double-check your work.\"\n",
    "\n",
    "    # Follow-up request for deductions summary\n",
    "    response2 = client.chat.completions.create(\n",
    "        model=\"gpt-5-mini\",\n",
    "        messages=[{\n",
    "            \"role\": \"system\",\n",
    "            \"content\": instructions\n",
    "        }, {\n",
    "            \"role\": \"user\", \n",
    "            \"content\": f\"\"\"The statement of the homework is as follows:\n",
    "\n",
    "        {statement}\n",
    "\n",
    "        A student has submitted the following Python code for this homework.\n",
    "\n",
    "        {code}\n",
    "\n",
    "        You also have access to the solution of this homework, which is as follows:\n",
    "\n",
    "        {solution}\n",
    "\n",
    "        In both the solution and the student's submission, each problem is separated with a comment line mentioning the problem number.\n",
    "\n",
    "        Use the following rubric:\n",
    "\n",
    "        {rubric}\n",
    "\n",
    "        Please grade the student's submission.\"\"\"\n",
    "        }, {\n",
    "            \"role\": \"assistant\",\n",
    "            \"content\": feedback\n",
    "        }, {\n",
    "            \"role\": \"user\",\n",
    "            \"content\": content\n",
    "        }],\n",
    "        # temperature=0\n",
    "    )\n",
    "\n",
    "    grade = response2.choices[0].message.content\n",
    "\n",
    "    return grade"
   ]
  },
