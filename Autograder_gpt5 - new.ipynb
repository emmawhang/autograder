    "import json\n",
    "import pandas as pd\n",
    "import os\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Assignment name\n",
    "assignment = \"Final\"\n",
    "\n",
    "# The column name in the gradebook for this assignment\n",
    "assignment_column = \"Assignment:Final (Real)\"\n",
    "\n",
    "# The name of the solution file\n",
    "assignment_solution_name = \"Final Project [COMPLETE].ipynb\"\n",
    "\n",
    "# The root directory for all the files\n",
    "path = \"C:/Users/skazempour/Dropbox/Teaching/Financial Analytics/Fall 2025/\"\n",
    "# path = \"C:/Users/smkaz/OneDrive/Desktop/\"\n",
    "\n",
    "# The path to the rubric, statement, solution, gradebook, submissions, and feedback\n",
    "rubric_path = path + f\"{assignment}/rubric.txt\"\n",
    "statement_path = path + f\"{assignment}/statement.txt\"\n",
    "solution_path = path + f\"{assignment}/{assignment_solution_name}\"\n",
    "gradebook_path = path + \"Gradebook.xlsx\"\n",
    "submissions_path = path + f\"{assignment}/Submissions/\"\n",
    "feedback_path = path + f\"{assignment}/Feedback/\"\n",
    "# pdf_path = path + f\"{assignment}/PDFs/\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [],
   "source": [
    "# The function to extract code from a Jupyter notebook\n",
    "def get_code(file_path):\n",
    "    \n",
    "    with open(file_path, \"r\") as f:\n",
    "        content = f.read()\n",
    "    \n",
    "    content_json = json.loads(content)\n",
    "\n",
    "    cells = [cell for cell in content_json['cells']]\n",
    "\n",
    "    code = []\n",
    "    problem = 0\n",
    "\n",
    "    for c in cells:\n",
    "        if c['source'] == []:\n",
    "            continue\n",
    "        if c['cell_type'] == 'markdown' and c['source'][0].startswith(\"# Problem\"):\n",
    "            problem += 1\n",
    "            code.append(f\"\\n\\n# Problem {problem}\\n\")\n",
    "        elif c['cell_type'] =='code':\n",
    "            code.append(\"\\n\")\n",
    "            code = code + c['source']\n",
    "    \n",
    "    code = \"\".join(code)\n",
    "\n",
    "    # if the convention for defining problems is not followed, problem will be 0\n",
    "    if problem == 0:\n",
    "        problem = 1\n",
    "    \n",
    "    return code, problem\n",
    "\n",
    "# The function to compile the deductions from the AI-generated feedback\n",
    "def compile_deductions(grade):\n",
    "    deductions = grade.split(\"--\")[1:]\n",
    "    deductions = [int(d.strip().split()[0].strip()) for d in deductions]\n",
    "    return deductions"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Read the gradebook, rubric file, and the problem statements"
   ]
  },
